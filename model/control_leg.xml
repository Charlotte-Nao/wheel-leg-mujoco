<mujoco model="five_link_wheel_leg_2d_fall_test">
  <compiler angle="degree" autolimits="true"/>

  <option timestep="0.001"
          gravity="0 0 -9.81"
          integrator="implicitfast"
          solver="Newton"
          iterations="100"/>

  <visual>
    <headlight ambient="0.35 0.35 0.35" diffuse="0.8 0.8 0.8" specular="0.2 0.2 0.2"/>
    <rgba joint="0.2 0.7 1 1" actuator="0.3 0.8 0.3 1"/>
  </visual>

  <default>
    <joint type="hinge"
           axis="0 1 0"
           damping="0.02"
           armature="0.0005"
           limited="false"/>
    <geom contype="0" conaffinity="1"
          friction="0.8 0.02 0.001"
          condim="3"/>
  </default>

  <worldbody>
    <light name="top_light" pos="0 -1 2" dir="0 0 -1"/>
    <camera name="side" pos="1.25 -1.8 0.85" xyaxes="0.82 0.57 0 -0.22 0.32 0.92"/>

<!-- 地面 -->
    <geom name="ground"
          type="plane"
          pos="0 0 0"
          size="40 20 0.1"
          rgba="0.82 0.84 0.86 1"
          contype="1" conaffinity="0"/>

    <!-- 单侧斜坡：只覆盖左轮轨迹，用于左右腿不同地形测试 -->
    <geom name="left_wheel_ramp"
          type="box"
          pos="2.0 0.25 0.140"
          size="0.75 0.14 0.01"
          euler="0 -10 0"
          friction="1.0 0.02 0.001"
          rgba="0.78 0.25 0.18 1"
          contype="1" conaffinity="0"/>

    <!-- 全宽飞坡：两轮同时上坡，末端无平台以测试起跳和落地 -->
    <geom name="launch_ramp"
          type="box"
          pos="5.5 0 0.218"
          size="1.0 0.70 0.01"
          euler="0 -12 0"
          friction="1.0 0.02 0.001"
          rgba="0.92 0.68 0.12 1"
          contype="1" conaffinity="0"/>

    <!-- 左右高度和坡度错开的连续路面，用于同时激励 pitch 与 roll -->
    <geom name="uneven_left_01" type="box"
          pos="12.00 0.35 0.010" size="0.21 0.34 0.010"
          euler="1.0 -1.5 0" rgba="0.34 0.48 0.32 1"
          contype="1" conaffinity="0"/>
    <geom name="uneven_right_01" type="box"
          pos="12.00 -0.35 0.016" size="0.21 0.34 0.016"
          euler="-1.5 1.0 0" rgba="0.39 0.53 0.36 1"
          contype="1" conaffinity="0"/>
    <geom name="uneven_left_02" type="box"
          pos="12.40 0.35 0.017" size="0.21 0.34 0.017"
          euler="-1.0 2.0 0" rgba="0.41 0.56 0.38 1"
          contype="1" conaffinity="0"/>
    <geom name="uneven_right_02" type="box"
          pos="12.40 -0.35 0.007" size="0.21 0.34 0.007"
          euler="1.0 -2.0 0" rgba="0.33 0.47 0.31 1"
          contype="1" conaffinity="0"/>
    <geom name="uneven_left_03" type="box"
          pos="12.80 0.35 0.008" size="0.21 0.34 0.008"
          euler="1.5 -1.0 0" rgba="0.36 0.50 0.33 1"
          contype="1" conaffinity="0"/>
    <geom name="uneven_right_03" type="box"
          pos="12.80 -0.35 0.019" size="0.21 0.34 0.019"
          euler="-1.0 1.5 0" rgba="0.43 0.57 0.39 1"
          contype="1" conaffinity="0"/>
    <geom name="uneven_left_04" type="box"
          pos="13.20 0.35 0.020" size="0.21 0.34 0.020"
          euler="-1.5 1.0 0" rgba="0.44 0.58 0.40 1"
          contype="1" conaffinity="0"/>
    <geom name="uneven_right_04" type="box"
          pos="13.20 -0.35 0.010" size="0.21 0.34 0.010"
          euler="1.5 -1.0 0" rgba="0.35 0.49 0.32 1"
          contype="1" conaffinity="0"/>
    <geom name="uneven_left_05" type="box"
          pos="13.60 0.35 0.012" size="0.21 0.34 0.012"
          euler="1.0 -2.0 0" rgba="0.38 0.52 0.35 1"
          contype="1" conaffinity="0"/>
    <geom name="uneven_right_05" type="box"
          pos="13.60 -0.35 0.005" size="0.21 0.34 0.005"
          euler="-1.0 2.0 0" rgba="0.31 0.45 0.30 1"
          contype="1" conaffinity="0"/>
    <geom name="uneven_left_06" type="box"
          pos="14.00 0.35 0.006" size="0.21 0.34 0.006"
          euler="-1.0 1.5 0" rgba="0.33 0.47 0.31 1"
          contype="1" conaffinity="0"/>
    <geom name="uneven_right_06" type="box"
          pos="14.00 -0.35 0.0175" size="0.21 0.34 0.0175"
          euler="1.0 -1.5 0" rgba="0.42 0.56 0.39 1"
          contype="1" conaffinity="0"/>
    <geom name="uneven_left_07" type="box"
          pos="14.40 0.35 0.015" size="0.21 0.34 0.015"
          euler="1.5 -1.0 0" rgba="0.40 0.54 0.37 1"
          contype="1" conaffinity="0"/>
    <geom name="uneven_right_07" type="box"
          pos="14.40 -0.35 0.009" size="0.21 0.34 0.009"
          euler="-1.5 1.0 0" rgba="0.35 0.49 0.33 1"
          contype="1" conaffinity="0"/>

    <!-- 斜坡上高台；高台末端没有下坡，形成 280 mm 垂直落差 -->
    <geom name="step_up_ramp"
          type="box"
          pos="27.20 0 0.140"
          size="0.75 0.70 0.01"
          euler="0 -10 0"
          friction="1.0 0.02 0.001"
          rgba="0.62 0.45 0.23 1"
          contype="1" conaffinity="0"/>
    <geom name="drop_platform"
          type="box"
          pos="28.695 0 0.140"
          size="0.755 0.70 0.140"
          friction="1.0 0.02 0.001"
          rgba="0.50 0.38 0.25 1"
          contype="1" conaffinity="0"/>

<!-- 车体 -->
    <body name="chassis" pos="0 0 0.5" euler="0 0 0">

      <inertial pos="0 0 0"
                mass="18.9"
                diaginertia="0.30 0.589763361 0.30"/>

      <freejoint name="base_free"/>

      <geom name="chassis_geom"
            type="box"
            pos="0 0 0.075"
            size="0.18 0.25 0.055"
            rgba="0.20 0.23 0.28 1"/>

      <site name="chassis_imu" pos="0 0 0" size="0.01"/>

      <!--   左侧腿部   -->
      <site name="left_hip_AE" type="sphere" pos="0 0.25 0" size="0.018" rgba="1 0.25 0.2 1"/>

      <!--   AB连杆   -->
      <body name="left_link_AB" pos="0 0.25 0" euler="0 120 0">
        <joint name="left_q1" pos="0 0 0" axis="0 1 0" ref="120"/>

        <geom name="left_AB_geom"
              type="capsule"
              fromto="0 0 0  0.21 0 0"
              size="0.012"
              mass="0.2375"
              rgba="0.15 0.45 0.85 1"/>
        <site name="left_B" type="sphere" pos="0.21 0 0" size="0.014" rgba="0.2 0.6 1 1"/>

        <!--  BC连杆  -->
        <body name="left_link_BC" pos="0.21 0 0" euler="0 -54.83458749 0">
          <joint name="left_q2_passive" pos="0 0 0" axis="0 1 0" ref="-54.83458749"/>

          <geom name="left_BC_geom"
                type="capsule"
                fromto="0 0 0  0.25 0 0"
                size="0.012"
                mass="0.2375"
                rgba="0.20 0.62 0.92 1"/>

          <!--  轮组  -->
          <body name="left_wheel" pos="0.25 0 0">
            <joint name="left_wheel_joint" pos="0 0 0" axis="0 1 0"
                   damping="0.002" armature="0.001"/>

            <geom name="left_wheel_geom"
                  type="cylinder"
                  size="0.06 0.025"
                  euler="90 0 0"
                  mass="0.6"
                  rgba="0.08 0.08 0.09 1"
                  contype="0" conaffinity="1"
                  friction="1.0 0.02 0.001"/>

            <site name="left_C_wheel" type="sphere" pos="0 0 0" size="0.016" rgba="1 0.8 0.1 1"/>
          </body>
        </body>
      </body>

      <!--ED连杆-->
      <body name="left_link_ED" pos="0 0.25 0" euler="0 60 0">
        <joint name="left_q4" pos="0 0 0" axis="0 1 0" ref="60"/>

        <geom name="left_ED_geom"
              type="capsule"
              fromto="0 0 0  0.21 0 0"
              size="0.012"
              mass="0.2375"
              rgba="0.85 0.35 0.20 1"/>
        <site name="left_D" type="sphere" pos="0.21 0 0" size="0.014" rgba="1 0.45 0.2 1"/>

        <!--DC连杆-->
        <body name="left_link_DC" pos="0.21 0 0" euler="0 54.83458749 0">
          <joint name="left_q3_passive" pos="0 0 0" axis="0 1 0" ref="54.83458749"/>

          <geom name="left_DC_geom"
                type="capsule"
                fromto="0 0 0  0.25 0 0"
                size="0.012"
                mass="0.2375"
                rgba="0.95 0.48 0.24 1"/>

          <site name="left_C_link" type="sphere" pos="0.25 0 0" size="0.012" rgba="0.8 0.1 0.8 0.8"/>
        </body>
      </body>

      <!--   右侧腿部   -->
      <site name="right_hip_AE" type="sphere" pos="0 -0.25 0" size="0.018" rgba="1 0.25 0.2 1"/>

      <!--   AB连杆   -->
      <body name="right_link_AB" pos="0 -0.25 0" euler="0 120 0">
        <joint name="right_q1" pos="0 0 0" axis="0 1 0" ref="120"/>

        <geom name="right_AB_geom"
              type="capsule"
              fromto="0 0 0  0.21 0 0"
              size="0.012"
              mass="0.2375"
              rgba="0.15 0.45 0.85 1"/>
        <site name="right_B" type="sphere" pos="0.21 0 0" size="0.014" rgba="0.2 0.6 1 1"/>

        <!--  BC连杆  -->
        <body name="right_link_BC" pos="0.21 0 0" euler="0 -54.83458749 0">
          <joint name="right_q2_passive" pos="0 0 0" axis="0 1 0" ref="-54.83458749"/>

          <geom name="right_BC_geom"
                type="capsule"
                fromto="0 0 0  0.25 0 0"
                size="0.012"
                mass="0.2375"
                rgba="0.20 0.62 0.92 1"/>

          <!--  轮组  -->
          <body name="right_wheel" pos="0.25 0 0">
            <joint name="right_wheel_joint" pos="0 0 0" axis="0 1 0"
                   damping="0.002" armature="0.001"/>

            <geom name="right_wheel_geom"
                  type="cylinder"
                  size="0.06 0.025"
                  euler="90 0 0"
                  mass="0.6"
                  rgba="0.08 0.08 0.09 1"
                  contype="0" conaffinity="1"
                  friction="1.0 0.02 0.001"/>

            <site name="right_C_wheel" type="sphere" pos="0 0 0" size="0.016" rgba="1 0.8 0.1 1"/>
          </body>
        </body>
      </body>

      <!--ED连杆-->
      <body name="right_link_ED" pos="0 -0.25 0" euler="0 60 0">
        <joint name="right_q4" pos="0 0 0" axis="0 1 0" ref="60"/>

        <geom name="right_ED_geom"
              type="capsule"
              fromto="0 0 0  0.21 0 0"
              size="0.012"
              mass="0.2375"
              rgba="0.85 0.35 0.20 1"/>
        <site name="right_D" type="sphere" pos="0.21 0 0" size="0.014" rgba="1 0.45 0.2 1"/>

        <!--DC连杆-->
        <body name="right_link_DC" pos="0.21 0 0" euler="0 54.83458749 0">
          <joint name="right_q3_passive" pos="0 0 0" axis="0 1 0" ref="54.83458749"/>

          <geom name="right_DC_geom"
                type="capsule"
                fromto="0 0 0  0.25 0 0"
                size="0.012"
                mass="0.2375"
                rgba="0.95 0.48 0.24 1"/>

          <site name="right_C_link" type="sphere" pos="0.25 0 0" size="0.012" rgba="0.8 0.1 0.8 0.8"/>
        </body>
      </body>
    </body>

    <!--
      动态障碍物必须位于车体之后，以保持机器人原有的 qpos/qvel 地址不变。
      17 mm 为球体直径；TPU 90A 按典型密度 1200 kg/m^3 建模，单球约 3.09 g。
    -->
    <replicate count="20" offset="0.027 0 0">
      <replicate count="10" offset="0 0.055 0">
        <body name="rolling_obstacle" pos="20.00 -0.2475 0.0088">
          <freejoint name="rolling_obstacle_free"/>
          <geom name="rolling_obstacle_geom"
                type="sphere" size="0.0085"
                density="1200"
                friction="0.8 0.01 0.0002"
                condim="6"
                solref="0.004 1"
                solimp="0.95 0.99 0.001"
                rgba="0.28 0.47 0.72 1"
                contype="1" conaffinity="1"/>
        </body>
      </replicate>
    </replicate>
  </worldbody>

  <equality>
    <connect name="left_five_link_closure"
             site1="left_C_wheel"
             site2="left_C_link"
             solref="0.002 1"
             solimp="0.95 0.99 0.001"/>
    <connect name="right_five_link_closure"
             site1="right_C_wheel"
             site2="right_C_link"
             solref="0.002 1"
             solimp="0.95 0.99 0.001"/>
  </equality>

  <actuator>
    <motor name="left_hip_q1_motor" joint="left_q1" gear="1" ctrlrange="-40 40"/>
    <motor name="left_hip_q4_motor" joint="left_q4" gear="1" ctrlrange="-40 40"/>
    <motor name="left_wheel_motor"  joint="left_wheel_joint" gear="1" ctrlrange="-10 10"/>

    <motor name="right_hip_q1_motor" joint="right_q1" gear="1" ctrlrange="-40 40"/>
    <motor name="right_hip_q4_motor" joint="right_q4" gear="1" ctrlrange="-40 40"/>
    <motor name="right_wheel_motor"  joint="right_wheel_joint" gear="1" ctrlrange="-10 10"/>
  </actuator>

  <sensor>
    <framepos name="chassis_pos" objtype="body" objname="chassis"/>
    <framequat name="chassis_quat" objtype="body" objname="chassis"/>
    <velocimeter name="chassis_vel" site="chassis_imu"/>
    <gyro name="chassis_gyro" site="chassis_imu"/>

    <jointpos name="left_q1_pos" joint="left_q1"/>
    <jointvel name="left_q1_vel" joint="left_q1"/>
    <jointpos name="left_q4_pos" joint="left_q4"/>
    <jointvel name="left_q4_vel" joint="left_q4"/>
    <jointpos name="left_wheel_pos" joint="left_wheel_joint"/>
    <jointvel name="left_wheel_vel" joint="left_wheel_joint"/>
    <framepos name="left_C_world_pos" objtype="site" objname="left_C_wheel"/>

    <jointpos name="right_q1_pos" joint="right_q1"/>
    <jointvel name="right_q1_vel" joint="right_q1"/>
    <jointpos name="right_q4_pos" joint="right_q4"/>
    <jointvel name="right_q4_vel" joint="right_q4"/>
    <jointpos name="right_wheel_pos" joint="right_wheel_joint"/>
    <jointvel name="right_wheel_vel" joint="right_wheel_joint"/>
    <framepos name="right_C_world_pos" objtype="site" objname="right_C_wheel"/>
  </sensor>
</mujoco>
